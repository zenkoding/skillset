{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(command -v:*)",
      "Bash(date:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(tree:*)",
      "Bash(uuidgen:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(docker build:*)",
      "Bash(docker exec:*)",
      "Bash(docker images:*)",
      "Bash(docker inspect:*)",
      "Bash(docker logs:*)",
      "Bash(docker ps:*)",
      "Bash(docker-compose down:*)",
      "Bash(docker-compose exec:*)",
      "Bash(docker-compose logs:*)",
      "Bash(docker-compose ps:*)",
      "Bash(docker-compose up:*)",
      "Bash(gh auth status:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh repo view:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git describe:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git push -u origin:*)",
      "Bash(git push origin:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git rebase:*)",
      "Bash(git remote -v:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git tag:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree remove:*)",
      "Bash(go build:*)",
      "Bash(go fmt:*)",
      "Bash(go list:*)",
      "Bash(go mod:*)",
      "Bash(go run:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(gofmt:*)",
      "Bash(goimports:*)",
      "Bash(kubectl api-resources:*)",
      "Bash(kubectl auth can-i:*)",
      "Bash(kubectl config current-context:*)",
      "Bash(kubectl config view:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl explain:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl top:*)",
      "Bash(kubectl version:*)",
      "Bash(make build:*)",
      "Bash(make check:*)",
      "Bash(make clean:*)",
      "Bash(make coverage:*)",
      "Bash(make fmt:*)",
      "Bash(make help:*)",
      "Bash(make lint:*)",
      "Bash(make plan:*)",
      "Bash(make test:*)",
      "Bash(make vet:*)",
      "Bash(tk diff:*)",
      "Bash(tk env current:*)",
      "Bash(tk env list:*)",
      "Bash(tk show:*)",
      "Bash(tk tool:*)",
      "Read(//tmp/**)"
    ],
    "ask": [
      "Bash(gh release create:*)",
      "Bash(gh api:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch --delete:*)",
      "Bash(git clean -f:*)",
      "Bash(git filter-branch:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl create:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl replace:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl set:*)",
      "Bash(kubectl exec:*)",
      "Bash(kubectl port-forward:*)",
      "Bash(kubectl cp:*)",
      "Bash(kubectl drain:*)",
      "Bash(kubectl cordon:*)",
      "Bash(kubectl uncordon:*)",
      "Bash(kubectl rollout restart:*)",
      "Bash(tk apply:*)",
      "Bash(tk prune:*)",
      "Bash(tk delete:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh release delete:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh issue transfer:*)",
      "Bash(gh secret:*)",
      "Bash(docker push:*)",
      "Bash(docker rmi:*)",
      "Bash(docker image rm:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker-compose down -v:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(gh api*-X DELETE*)",
      "Bash(gh api*-XDELETE*)",
      "Bash(gh api*--method DELETE*)",
      "Bash(gh api*--method=DELETE*)",
      "Bash(gh api*-X delete*)",
      "Bash(gh api*-Xdelete*)",
      "Bash(gh api*--method delete*)",
      "Bash(gh api*--method=delete*)"
    ],
    "additionalDirectories": [
      "~/.local/share/agents"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.claude/hooks/project-knowledge.sh ] && exec ~/.claude/hooks/project-knowledge.sh || exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "command -v dcg >/dev/null 2>&1 && exec dcg || exit 0"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "outputStyle": "Dry",
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": [
        "~/.local/share/agents"
      ]
    }
  },
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "low"
    },
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "low"
    }
  },
  "advisorModel": "opus",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "switchModelsOnFlag": false,
  "teammateMode": "in-process",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
